# Variables attendues par l'application. Copiez ce fichier en `.env.local`
# et renseignez les valeurs de votre projet Supabase.
#
#   Dashboard → Project Settings → API
#
# La clé publiable part dans le navigateur : c'est prévu. Ce qui protège les
# données, ce sont les politiques RLS définies dans `supabase/migrations/`.
#
# La clé de service (`service_role` / `sb_secret_...`) ne doit JAMAIS figurer
# dans un fichier préfixé `NEXT_PUBLIC_`, ni dans aucun fichier lu côté client :
# elle contourne la RLS.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
